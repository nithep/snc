# ============================================================================
# .env.example — ตัวอย่างตัวแปรสภาพแวดล้อมสำหรับ API Server (api/)
# ----------------------------------------------------------------------------
# วิธีใช้: คัดลอกเป็น api/.env แล้วกรอกค่าจริง
#   cp .env.example .env   (แล้วแก้ค่า / chmod 600)
# ห้าม commit ไฟล์ .env จริง (ดู .gitignore)
# ============================================================================

# --- Auth: X-API-Key สำหรับเขียนข้อมูล (trigger/ack/clear) ---
# บังคับตั้งใน production — ถ้าไม่ตั้ง backend จะ fail-closed (กันเขียนโดยไม่ auth)
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
# ต้องตรงกับ pbx/.env (listener ใช้ key เดียวกันส่ง header)
SNC_API_KEY=

# --- ฐานข้อมูล ---
# backend สำหรับเก็บ event: sqlite | firestore
#   sqlite    — ใช้บน Pi4 (ไฟล์ในเครื่อง)
#   firestore — ใช้บน Cloud Run (persistent, ไม่หายตอน scale-to-zero)
SNC_DB_BACKEND=sqlite

# path ของไฟล์ SQLite (ใช้เมื่อ SNC_DB_BACKEND=sqlite)
SNC_SQLITE_PATH=nurse_call_events.db

# --- Rate limiting (ใน-memory ต่อ IP ต่อนาที) ---
SNC_RATE_LIMIT_GET=120
SNC_RATE_LIMIT_WRITE=20

# --- AI: Gemini Executive Summary (ภาษาไทย) ---
# คีย์ Google AI Studio (Gemini REST) — ใช้สำหรับ /api/ai/* ถ้าไม่มี จะใช้ Local Fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Google Chat Webhook (สำหรับส่งสรุปรายงานเข้า Google Chat) ---
GOOGLE_CHAT_WEBHOOK_URL=