# Dockerfile.bridge — image จิ๋วสำหรับ SNC Alert Bridge (แยกจาก backend หลัก)
# build context = repo root (เหมือน api/Dockerfile):
#   docker build -f api/Dockerfile.bridge -t gcr.io/<PROJECT>/snc-alert-bridge:latest .
#   หรือ: gcloud builds submit --config api/cloudbuild-bridge.yaml .
FROM python:3.11-slim

WORKDIR /app

# ใช้ requirements-bridge.txt (เฉพาะ fastapi+uvicorn — ไม่ดึง firestore/ai libs)
COPY api/requirements-bridge.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY api/bridge_server.py .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python3", "bridge_server.py"]
