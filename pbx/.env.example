# ============================================================================
# .env.example — ตัวอย่างตัวแปรสภาพแวดล้อมสำหรับ PBX Listener (pbx/)
# ----------------------------------------------------------------------------
# วิธีใช้: คัดลอกเป็น pbx/.env แล้วกรอกค่าจริง (chmod 600)
# ห้าม commit ไฟล์ .env จริง (ดู .gitignore)
# ============================================================================

# --- การเชื่อมต่อตู้ Phonik PBX (Telnet) ---
PBX_IP=192.168.1.91
PBX_PORT=23
# รหัสผ่านตู้ Phonik — ตั้งจริงใน production (ห้ามปล่อย default 1234)
PBX_PASS=

# --- Backend ปลายทาง ---
# API URL สำหรับส่ง event (local Pi หรือ Cloud Run)
#   local:  http://localhost:8000
#   cloud:  https://<service>.run.app
BACKEND_API_URL=http://localhost:8000
CLOUD_RUN_API_URL=

# X-API-Key เดียวกับ api/.env (listener ใช้ส่ง header ตอน POST trigger)
SNC_API_KEY=

# --- Durable Outbox (ADR 0004) ---
# path ไฟล์ SQLite outbox (เก็บ event pending ก่อนส่ง + retry)
SNC_OUTBOX_PATH=snc_event_outbox.db
# วินาทีรอระหว่าง retry ของ outbox loop
OUTBOX_RETRY_INTERVAL=15

# --- TCP Proxy (พอร์ต 2323 สำหรับ Room Manager) ---
PROXY_PORT=2323

# --- Resilience tuning (ปรับได้ตามต้องการ) ---
# วินาทีระหว่าง RDSS poll (ตู้ dump สถานะห้อง)
RDSS_POLL_INTERVAL=3
# ตรวจ silence: ถ้าไม่ได้รับข้อมูลเกินนี้(วิ) → force reconnect
WATCHDOG_SILENCE_TIMEOUT=60
# ตรวจ silence ทุกกี่วินาที
WATCHDOG_CHECK_INTERVAL=10