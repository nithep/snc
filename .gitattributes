# Normalize line endings: repo เก็บ LF เสมอ ป้องกัน diff noise จาก CRLF/LF
* text=auto

# Source / script / doc: LF ทั้งใน repo และ working tree
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.service text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# Windows scripts: CRLF ใน working tree (repo ยังเก็บ LF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ไฟล์ไบนารี — ห้ามแปลง line ending
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# ไฟล์ความลับ — ไม่ควรถูก track อยู่แล้ว (กันพลาด)
.env binary
.env.* binary
