# ============================================================================
# .env.example — ตัวอย่างตัวแปรสภาพแวดล้อม/คอนฟิกสำหรับ Ops (ops/)
# ----------------------------------------------------------------------------
# ใช้สำหรับ deploy / backup / monitor / verify บน Pi4
# วิธีใช้: คัดลอกเป็น ops/.env หรือ export ตามค่าจริง (chmod 600)
# ห้าม commit ไฟล์ .env จริง (ดู .gitignore)
# ============================================================================

# --- เป้าหมายการ deploy (Pi4) ---
# alias SSH ใช้กับ deploy-snc-one-shot.sh (ดู ~/.ssh/config)
PI_HOST=pi4
# user + path บน Pi (systemd: WorkingDirectory=api/ , pbx/)
PI_USER=ecs-agent
PI_ROOT=/home/ecs-agent/snc

# --- ตำแหน่งของระบบบน Pi (เปลี่ยนจาก legacy /home/ecs-agent/snc-poc) ---
SNC_ROOT=/home/ecs-agent/snc

# --- การเชื่อมต่อ PBX / Proxy (ใช้ใน verify) ---
PBX_HOST=192.168.1.91
PBX_PORT=23
PROXY_PORT=2323

# --- Cloud Run (ใช้ใน verify + deploy cloud) ---
# backend + bridge URL (ระบุ project/region ตามจริง)
CLOUD_RUN_BACKEND_URL=https://snc-cloud-backend-<PROJECT>.asia-southeast1.run.app
CLOUD_RUN_BRIDGE_URL=https://snc-alert-bridge-<PROJECT>.asia-southeast1.run.app
GCP_PROJECT_ID=hotel-ecs-nithep

# --- Telegram แจ้งเตือน (verify-daily / evening-digest / burnin-reminder) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backup ---
# path ไฟล์ DB + dir สำรอง (ควรมี offsite/off-Pi copy ด้วย)
SNC_SQLITE_PATH=/home/ecs-agent/snc/api/nurse_call_events.db
BACKUP_DIR=/home/ecs-agent/snc/backups
# วันเก็บ retention ของ backup
BACKUP_RETENTION_DAYS=14